# Copy to .env. Load with: uvicorn api.main:app --reload --env-file .env

# --- Local development basics ---
TRUEACRE_ENV=development
TRUEACRE_DEV_LOGIN=1
SESSION_SECRET=change-me-to-something-long-and-random
# DATABASE_URL defaults to sqlite:///trueacre.db; for Postgres: postgresql+psycopg://user:pass@host/db?sslmode=require
# DATA_ENCRYPTION_KEY is derived from SESSION_SECRET in development; production needs its own (python -m api.crypto)

# --- Optional: limits and timeouts. Defaults shown; uncomment to change. ---
#TRUEACRE_LOGIN_LIMIT=10
#TRUEACRE_UPLOAD_LIMIT=30
#TRUEACRE_MAX_UPLOAD_MB=20
#TRUEACRE_MAX_UPLOAD_ROWS=500000
#TRUEACRE_EXPLAIN_LIMIT=20
#TRUEACRE_LLM_TIMEOUT=120
#TRUEACRE_USDA_LIMIT=5
#TRUEACRE_USDA_TIMEOUT=60

# --- Optional: fill county yields from USDA (free key from https://quickstats.nass.usda.gov/api) ---
#NASS_API_KEY=

# --- Optional: plain-English explanations. Keep exactly one provider block uncommented. ---
# Leave TRUEACRE_LLM_PROVIDER unset to disable explanations entirely; nothing is ever sent anywhere.

# --- Gemini (free tier available) ---
TRUEACRE_LLM_PROVIDER=gemini
TRUEACRE_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your-key-from-aistudio.google.com

# --- Local model with Ollama: no key, nothing leaves your machine. First: ollama pull <model> ---
#TRUEACRE_LLM_PROVIDER=ollama
#TRUEACRE_LLM_MODEL=<name shown by `ollama list`>

# --- Local model with LM Studio (start its local server first) ---
#TRUEACRE_LLM_PROVIDER=lmstudio
#TRUEACRE_LLM_MODEL=<model name shown in LM Studio>

# --- OpenAI ---
#TRUEACRE_LLM_PROVIDER=openai
#TRUEACRE_LLM_MODEL=<model id from platform.openai.com>
#OPENAI_API_KEY=

# --- Anthropic, through its OpenAI-compatible endpoint (not exercised by this repo's tests) ---
#TRUEACRE_LLM_PROVIDER=anthropic
#TRUEACRE_LLM_MODEL=<model id from docs.anthropic.com>
#ANTHROPIC_API_KEY=

# --- Anything else that speaks the OpenAI chat completions API: llama.cpp, vLLM, OpenRouter, a remote Ollama ---
#TRUEACRE_LLM_PROVIDER=custom
#TRUEACRE_LLM_BASE_URL=http://gpu-box:11434/v1
#TRUEACRE_LLM_MODEL=
#TRUEACRE_LLM_API_KEY=
